'use strict';
var elements = document.querySelectorAll('.population');
var populations = Array.from(elements).map(function(span) {
    return parseInt(span.textContent.replace(/,/g, ''), 10);
});
var total = populations.reduce(function(sum, element) {
    return sum + element;
}, 0).toLocaleString();
var average = Math.floor(parseInt(total.replace(/,/g, ''), 10) / elements.length).toLocaleString();
var classTotal = document.querySelector('.total-population');
classTotal.textContent = total;
var classAverage = document.querySelector('.average-population');
classAverage.textContent = average;

